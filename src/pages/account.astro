import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="راهنمای حساب کاربری">
  <article class="page-width page-hero" style="max-width:820px;margin-inline:auto;padding-bottom:64px">
    <h1>راهنمای حساب کاربری</h1>
    <p>برای ساخت حساب، از صفحه <a href="/login">ورود و ثبت‌نام</a> گزینه ساخت حساب را انتخاب کنید. نام کاربری، ایمیل، نام نمایشی و رمز عبور لازم است. از رمز یکتایی استفاده کنید؛ گیم‌کلاب آن را به‌شکل هش‌شده نگهداری می‌کند.</p>
    <p>پس از ورود می‌توانید نام نمایشی و معرفی کوتاه را ویرایش کنید، عضو گروه شوید، درخواست دوستی بفرستید و با دوستان پیام خصوصی ردوبدل کنید. نوشته‌های عمومی را همه بازدیدکنندگان می‌بینند؛ پیام خصوصی فقط برای دو طرف در رابط کاربری نمایش داده می‌شود.</p>
    <p>خروج از حساب، نشانه ورود را از مرورگر فعلی پاک می‌کند. قابلیت حذف مستقل حساب و خبرنامه هنوز ارائه نشده است. برای درخواست حذف داده‌ها فعلاً راه تماس پشتیبانی در دسترس نیست؛ این محدودیت باید پیش از بازشدن ثبت‌نام برطرف شود.</p>
    <p><a href="/privacy">سیاست حریم خصوصی</a> · <a href="/community-guidelines">راهنمای جامعه</a></p>
  </article>
</BaseLayout>
